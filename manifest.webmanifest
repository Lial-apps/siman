{
  "id": "/siman/",
  "name": "סימן",
  "short_name": "סימן",
  "description": "לסמן, לחתום, לתרגם ולשלוח מסמכים — PDF, Word ו-Excel — ולתמלל שיחות והודעות קוליות. הקבצים נשארים במכשיר שלכם.",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#202125",
  "theme_color": "#202125",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-wide-1.png",
      "sizes": "1366x820",
      "type": "image/png",
      "form_factor": "wide",
      "label": "מה נסמן היום? מסך הפתיחה של סימן"
    },
    {
      "src": "screenshot-wide-2.png",
      "sizes": "1366x820",
      "type": "image/png",
      "form_factor": "wide",
      "label": "סימון וחתימה על הסכם"
    },
    {
      "src": "screenshot-wide-3.png",
      "sizes": "1366x820",
      "type": "image/png",
      "form_factor": "wide",
      "label": "שורת הפקודה: כותבים מה לעשות"
    },
    {
      "src": "screenshot-narrow-1.png",
      "sizes": "412x915",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "סימן בטלפון"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    },
    {
      "action": "./",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/msword": [
          ".doc"
        ]
      }
    },
    {
      "action": "./",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ]
      }
    },
    {
      "action": "./",
      "accept": {
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ]
      }
    },
    {
      "action": "./",
      "accept": {
        "audio/*": [
          ".mp3",
          ".m4a",
          ".wav",
          ".ogg",
          ".opus",
          ".aac",
          ".flac",
          ".webm",
          ".amr"
        ]
      }
    }
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "audio/*",
            "video/*",
            ".opus",
            ".ogg",
            ".oga",
            ".m4a",
            ".mp3",
            ".wav",
            ".aac",
            ".amr",
            ".3gp",
            ".webm",
            ".mp4",
            ".mov",
            "application/pdf",
            ".pdf",
            ".docx",
            ".xlsx",
            ".pptx"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "להקליט ולתמלל",
      "short_name": "הקלטה",
      "url": "./?voice=rec",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "התמלילים שלי",
      "short_name": "תמלילים",
      "url": "./?voice=lib",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}